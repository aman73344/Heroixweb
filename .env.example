# ==============================================================================
# HEROIX - environment variables
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
# `.env.local` is git-ignored, so real keys are never committed.
#
# On Vercel add every variable below in
#     Dashboard -> <your project> -> Settings -> Environment Variables
# (mark the server-only ones as "Sensitive" - see the notes per variable).
# ==============================================================================

# --- Supabase ----------------------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so on
# Vercel they must be present for the BUILD, not only at runtime.
# The anon/publishable key is safe to expose; the service key is NOT.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key - bypasses RLS. Server only. NEVER prefix with NEXT_PUBLIC_
# and NEVER commit it. Required by /api/admin-products and /api/test-db.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Optional duplicates of the two values above, used by the server helpers and by
# next.config.mjs. If you do not set them the NEXT_PUBLIC_ pair is used.
# SUPABASE_URL=your_supabase_project_url
# SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Chatbot (OpenRouter) ----------------------------------------------------
# Server only. Without it the chat falls back to canned replies.
OPENROUTER_API_KEY=your_openrouter_api_key
# Sent as the HTTP-Referer header for OpenRouter. Optional.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Hidden admin area (/heroix-gate) ----------------------------------------
# ADMIN_EMAIL           email accepted by the gate
# ADMIN_EMAILS          optional comma separated list of extra admin emails
# ADMIN_PASSWORD        the admin password (change it, never commit it)
# ADMIN_SESSION_SECRET  random value used to sign the session cookie
# All four are server only and must be marked "Sensitive" on Vercel.
# ADMIN_SESSION_SECRET must be at least 16 characters; if it is missing the
# admin area fails closed (stays locked) and login reports the problem.
ADMIN_EMAIL=you@example.com
# ADMIN_EMAILS=admin1@heroix.com,admin2@heroix.com
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_SESSION_SECRET=random-48-char-secret
