# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/
next.user-config.*

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store
data/

# TypeScript incremental build cache (was accidentally committed)
*.tsbuildinfo

# Local scratch files (tmp scripts, logs, compiled test output)
tmp-*
temp.txt

# One-off diagnostic output from the terminal / verification scripts
# (scripts/term-diag.ps1, scripts/smoke*.mjs, scripts/verify-fixes.mjs)
term-diag-out.txt
clean-*.txt
*-out.txt
*-err.txt
tsc*.log
verify-*.txt
smoke-*.txt
v-dump.txt
proc-dump.txt

# Keep npm as the single source of truth: committing a second lockfile
# (pnpm-lock.yaml / yarn.lock) makes Vercel pick a different package manager
# than the one used locally, which silently installs a different tree.
pnpm-lock.yaml
yarn.lock

